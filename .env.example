APP_NAME=Erdgut
APP_ENV=local
APP_KEY=
# Generate per environment. Never commit real keys.
# Local: php artisan key:generate
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
APP_URL=http://localhost
APP_URL_STAGING=https://staging.erd-gut.de
APP_URL_PRODUCTION=https://erd-gut.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Catalog images use storage/app/public (see disk "public" in config/filesystems.php).
# Run once per server: php artisan storage:link
# IONOS: increase upload_max_filesize / post_max_size for admin image uploads.
# FILESYSTEM_DISK=local

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=ionos
LOG_STACK=daily
LOG_IONOS_STACK=daily,critical_daily
LOG_DEPRECATIONS_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
LOG_CRITICAL_LEVEL=warning
LOG_CRITICAL_DAYS=60

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erdgut
DB_USERNAME=erdgut
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true in staging/production so session cookies are sent only over HTTPS
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@erd-gut.de"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_FORM_TO=

# Feature flags
FEATURE_SHOP_EXTRAS=true

# Payment retry attempts before pausing subscription (ERD-092, ERD-093)
PAYMENT_MAX_RETRIES=3

# Admin operations (ERD-187/186): upcoming charges list window; stale pending alert threshold (hours)
ADMIN_UPCOMING_CHARGES_DAYS=30
ADMIN_PENDING_PAYMENT_STALE_HOURS=48
# Forward weeks for admin box planner (ERD-190+); clamped 1–8 in config
ADMIN_BOX_PLANNER_WEEKS_AHEAD=4

# Customer box line-item editing (false = preset boxes only at launch)
CUSTOMER_BOX_EDITING_ENABLED=true

# SumUp integration
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_CURRENCY=EUR
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=
# Server-to-server POST only — never use as checkout return_url
SUMUP_WEBHOOK_URL="${APP_URL}/api/sumup/webhook"
# Optional. Browser URL after 3DS (defaults to subscription overview). Must be HTTPS in production.
# SUMUP_CHECKOUT_RETURN_URL="${APP_URL}/app/subscriptions"
SUMUP_MODE=sandbox

# IONOS cron trigger key used by /cron/run?key=...
# Must be replaced in staging/production with a random secret.
# Loaded via config/cron.php so it works with `php artisan config:cache`.
CRON_KEY=change-this-32-char-secret

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
