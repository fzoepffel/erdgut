APP_NAME=Erdgut
APP_ENV=local
APP_KEY=
# Generate per environment. Never commit real keys.
# Local: php artisan key:generate
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
# Must include the port when using `php artisan serve` — otherwise
# absolute route URLs (e.g. SumUp post-checkout redirect) land on :80
# and the browser silently fails. Match this to your dev server port.
APP_URL=http://localhost:8000
APP_URL_STAGING=https://staging.erd-gut.de
APP_URL_PRODUCTION=https://erd-gut.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Catalog images use storage/app/public (see disk "public" in config/filesystems.php).
# Run once per server: php artisan storage:link
# IONOS: increase upload_max_filesize / post_max_size for admin image uploads.
# FILESYSTEM_DISK=local

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=ionos
LOG_STACK=daily
LOG_IONOS_STACK=daily,critical_daily
LOG_DEPRECATIONS_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
LOG_CRITICAL_LEVEL=warning
LOG_CRITICAL_DAYS=60

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erdgut
DB_USERNAME=erdgut
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true in staging/production so session cookies are sent only over HTTPS
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Leave MAIL_SCHEME empty (or remove it): the mailer then negotiates TLS
# automatically (implicit TLS on port 465, STARTTLS on 587). Valid values are
# only "smtp" or "smtps"; "tls" is NOT valid and breaks every send.
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@erd-gut.de"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_FORM_TO=

# List-Unsubscribe header points to this mailbox on every outgoing message.
# Required for Gmail/Yahoo bulk-sender compliance. See docs/email-deliverability.md.
MAIL_UNSUBSCRIBE_MAILBOX="unsubscribe@erd-gut.de"

# Shop — seller details printed on PDF receipts (Kleinbetragsrechnung § 33 UStDV)
SHOP_COMPANY_NAME="Erdgut"
SHOP_COMPANY_STREET=""
SHOP_COMPANY_POSTAL_CITY=""
SHOP_COMPANY_PHONE=""
SHOP_COMPANY_EMAIL="kontakt@erd-gut.de"
# Umsatzsteuer-ID (DE...) or Steuernummer of the seller
SHOP_COMPANY_VAT_ID=""
# Additional seller details for full B2B invoices (§ 14 UStG): Steuernummer,
# bank + IBAN (payment terms), Handelsregister entry. Required on restaurant invoices.
SHOP_COMPANY_TAX_NUMBER=""
SHOP_COMPANY_IBAN=""
SHOP_COMPANY_BANK=""
SHOP_COMPANY_REGISTER=""
# Restaurant (B2B) invoice numbering + payment terms
SHOP_RESTAURANT_INVOICE_PREFIX="RG"
SHOP_RESTAURANT_INVOICE_DUE_DAYS="14"

# Shop product ranking (margin-per-impression Thompson-sampling bandit)
SHOP_RANKING_ENABLED=true
SHOP_RANKING_OBJECTIVE="margin"        # margin (uses buying prices, revenue fallback) | revenue
SHOP_RANKING_HALF_LIFE_DAYS=28         # sale/impression weight halves after this many days
SHOP_RANKING_PRIOR_ALPHA=1.0           # Beta prior for a no-data product's add-to-cart rate
SHOP_RANKING_PRIOR_BETA=20.0
SHOP_RANKING_STATS_TTL=900             # seconds the decayed-stats aggregate is cached
SHOP_RANKING_IMPRESSION_VISIBILITY=0.5 # card fraction visible before it counts as seen
SHOP_RANKING_BEACON_DEBOUNCE_MS=2000

# Feature flags
FEATURE_SHOP_EXTRAS=true

# Payment retry attempts before pausing subscription (ERD-092, ERD-093)
PAYMENT_MAX_RETRIES=3

# Admin operations (ERD-187/186): upcoming charges list window; stale pending alert threshold (hours)
ADMIN_UPCOMING_CHARGES_DAYS=30
ADMIN_PENDING_PAYMENT_STALE_HOURS=48
# Forward weeks for admin box planner (ERD-190+); clamped 1–8 in config
ADMIN_BOX_PLANNER_WEEKS_AHEAD=4
# When true, admins may edit box line items even if locked or past deadline (risky)
ADMIN_BOX_LINE_EDIT_OVERRIDE=false

# Customer box line-item editing (false = preset boxes only at launch)
CUSTOMER_BOX_EDITING_ENABLED=true

# Box TTC / included value (recurring charge base before add-ons; small=Klein, medium=Standard, large=Groß)
BOX_INCLUDED_VALUE_SMALL=20
BOX_INCLUDED_VALUE_MEDIUM=35
BOX_INCLUDED_VALUE_LARGE=42
# First paid recurring charge uses trial_price_ttc until webhook sets trial_completed_at (any box size)
BOX_TRIAL_BILLING_ENABLED=true
BOX_TRIAL_PRICE_TTC=35
BOX_EGGS_DAIRY_ADD_ON_EUR=4.5
# Admin planner: optional display hint = budget × (1 − rate); does not block edits (0–1, e.g. 0.30)
BOX_ADMIN_PLANNING_MARGIN_RATE=0.30

# SumUp — shared
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_CURRENCY=EUR

# SumUp — Spargel shop (LIVE credentials — real money)
SUMUP_SPARGEL_API_KEY=
SUMUP_SPARGEL_MERCHANT_CODE=
# Browser URL after payment (SpargelOrderController@return). Must be HTTPS in production.
SUMUP_SPARGEL_CHECKOUT_RETURN_URL="${APP_URL}/spargel/{id}/return"

# SumUp — Subscriptions & trial orders (SANDBOX credentials during development)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=
# Server-to-server POST only — never use as checkout return_url
SUMUP_WEBHOOK_URL="${APP_URL}/api/sumup/webhook"
# Optional. Browser URL after 3DS (defaults to subscription overview). Must be HTTPS in production.
# SUMUP_CHECKOUT_RETURN_URL="${APP_URL}/app/subscriptions"
SUMUP_MODE=sandbox

# Spargel weekly inventory link (Phase 3, 2026-05-09).
# Point each at the Product row id you've set up for the white / green
# spargel under the relevant producer. Both products must have unit=g.
# Leave unset for environments that don't run the spargel form.
SPARGEL_PRODUCT_ID_WHITE=
SPARGEL_PRODUCT_ID_GREEN=

# IONOS cron trigger key used by /cron/run?key=...
# Must be replaced in staging/production with a random secret.
# Loaded via config/cron.php so it works with `php artisan config:cache`.
CRON_KEY=change-this-32-char-secret

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cap SMTP connect/send time (seconds). Never unlimited: on IONOS CGI a
# hanging SMTP connection would hang the visitor's request with it.
MAIL_TIMEOUT=20
